# Environment Variables — copie para .env e preencha
# ======================================================

# App
APP_NAME=medical-reports-api
DEBUG=1
LOG_LEVEL=INFO
SECRET_KEY=change-me-to-a-random-secret

# Database (Railway managed PostgreSQL)
DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/medical_reports

# Redis
REDIS_URL=redis://localhost:6379/0

# Anthropic (Claude)
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI (fallback / embeddings)
OPENAI_API_KEY=sk-...

# Whaha API (WhatsApp)
WHAHA_TOKEN=whh_...
WHAHA_API_URL=https://api.whaha.com/v1
WHAHA_WEBHOOK_SECRET=

# Google Workspace
GOOGLE_CREDENTIALS_JSON={}

# Sentry
SENTRY_DSN=

# Encryption
ENCRYPTION_KEY=
